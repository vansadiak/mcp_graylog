# Graylog Configuration
GRAYLOG_ENDPOINT=https://your-graylog-server:9000
GRAYLOG_TOKEN=your-api-token
# Optional: Cookie string for OAuth2 authentication (format: key1=value1; key2=value2; key3=value3)
GRAYLOG_COOKIES=key1=value1; key2=value2; key3=value3

# Optional Graylog Settings
GRAYLOG_VERIFY_SSL=true
GRAYLOG_TIMEOUT=30

# MCP Server Configuration
MCP_SERVER_PORT=8000
MCP_SERVER_HOST=0.0.0.0

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json 